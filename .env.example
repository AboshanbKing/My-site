# Public frontend URL of the deployed serverless proxy, for example:
# VITE_KICK_API_URL=https://your-kick-proxy.vercel.app/api/kick-channel
VITE_KICK_API_URL=/api/kick-channel

# Configure these only in the serverless provider, never in the Vite frontend:
# KICK_CLIENT_ID=your_kick_app_client_id
# KICK_CLIENT_SECRET=your_kick_app_client_secret
# KICK_CHANNEL_SLUG=aboshanb-king
# KICK_ALLOWED_ORIGIN=https://your-github-username.github.io
